 {
  "name": "speak",
  "description": "Say something out loud (about 3 words per second). Whispering carries 3 blocks at the same rate as talk, with no shout cooldown; people beyond 3 but within 8 blocks who can see you notice talking without hearing the words. Talking carries 8 blocks; shouting carries 24 blocks, takes longer, is noticed from farther away, and can only be done once every 30 seconds. People only catch your words if they are in range for the whole time you speak.",
  "parameters": {
   "type": "object",
   "properties": {
    "text": {
     "type": "string",
     "maxLength": 600,
     "description": "At most about 100 words."
    },
    "volume": {
     "type": "string",
     "enum": [
      "whisper",
      "talk",
      "shout"
     ]
    },
    "to": {
     "type": "string",
     "description": "Optional: the person you are addressing (others may overhear)."
    },
    "note": {
     "type": "string",
     "maxLength": 100
    }
   },
   "required": [
    "text"
   ],
   "additionalProperties": false
  }
 },
 {
